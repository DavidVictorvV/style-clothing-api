# Replicate API Token
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Optional: Cloud storage credentials (if using S3, Cloudinary, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Optional: Database connection (if using remote profile storage)
# DATABASE_URL=
